{
  "name": "pipilot",
  "productName": "PiPilot",
  "description": "An Electron desktop client for the local Pi coding agent",
  "author": "PiPilot contributors",
  "private": true,
  "version": "0.0.2",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && electron-vite build",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "package:mac": "pnpm build && electron-builder --mac --arm64 --x64 --publish never",
    "package:win": "pnpm build && electron-builder --win --x64 --publish never",
    "package:linux": "pnpm build && electron-builder --linux --x64 --publish never",
    "package:win:update": "pnpm build && electron-builder --config electron-builder.update.yml --win --x64 --publish never",
    "package:linux:update": "pnpm build && electron-builder --config electron-builder.update.yml --linux --x64 --publish never",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "pnpm rebuild:native",
    "preview": "electron-vite preview",
    "test": "node build/verify-test-fixtures.cjs && vitest run",
    "test:unit": "node build/verify-test-fixtures.cjs && vitest run",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "test:electron": "playwright test --config=playwright.electron.config.ts",
    "test:packaged": "playwright test --config=playwright.packaged.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/server": "2.0.0",
    "electron-updater": "6.8.9",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@pierre/diffs": "1.3.5",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-mention": "3.30.2",
    "@tiptap/pm": "3.30.2",
    "@tiptap/react": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "@tiptap/suggestion": "3.30.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^43.4.1",
    "electron-builder": "26.15.7",
    "electron-vite": "6.0.0-beta.1",
    "material-icon-theme": "5.37.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.12.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
