{
  "name": "pipilot",
  "productName": "PiPilot",
  "description": "An Electron desktop client for the local Pi coding agent",
  "author": "PiPilot contributors",
  "private": true,
  "version": "0.6.0",
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && electron-vite build",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "package:mac": "pnpm build && electron-builder --mac --arm64 --x64 --publish never",
    "package:win": "pnpm build && electron-builder --win --x64 --publish never && node build/build-windows-portable.cjs",
    "package:linux": "pnpm build && electron-builder --linux --x64 --publish never",
    "package:win:update": "pnpm build && electron-builder --config electron-builder.update.yml --win --x64 --publish never && node build/build-windows-portable.cjs",
    "package:linux:update": "pnpm build && electron-builder --config electron-builder.update.yml --linux --x64 --publish never",
    "package:linux:arm64:update": "pnpm build && electron-builder --config electron-builder.update.yml --linux --arm64 --publish never",
    "rebuild:native": "install-electron && electron-builder install-app-deps",
    "postinstall": "pnpm rebuild:native",
    "preview": "electron-vite preview",
    "test": "node build/verify-test-fixtures.cjs && vitest run",
    "test:unit": "node build/verify-test-fixtures.cjs && vitest run",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "test:electron": "playwright test --config=playwright.electron.config.ts",
    "test:packaged": "playwright test --config=playwright.packaged.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@lobehub/icons-static-svg": "1.95.1",
    "@modelcontextprotocol/server": "2.3.1",
    "electron-updater": "6.8.9",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "pipilot-npm": "npm:npm@12.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@pierre/diffs": "1.5.2",
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0-beta.7",
    "material-icon-theme": "5.39.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.14.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "^5.0.3"
  }
}
